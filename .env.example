# Shared
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/classroom
REDIS_URL=redis://default:password@localhost:6379
INTERNAL_API_KEY=replace-with-32-char
AUTH_COOKIE_NAME=classroom.session
NEXTAUTH_SECRET=replace-with-secret
NEXTAUTH_URL=https://classroom.example.com
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
DEFAULT_ADMIN_ID=
FALLBACK_ADMIN_ID=
JWT_SECRET=replace-with-long-secret

# Web
NEXT_PUBLIC_SITE_URL=https://classroom.example.com
NEXT_PUBLIC_API_URL=https://api.classroom.example.com
NEXT_PUBLIC_SENTRY_DSN=

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET=classroom-assets
STORAGE_R2_PUBLIC_URL=https://cdn.classroom.example.com

# Legacy Migration
SQLITE_DB_PATH=./prisma/dev.db
LEGACY_ASSETS_DIR=./public/uploads
