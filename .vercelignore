
# Minimal .vercelignore — exclude large or irrelevant folders but allow apps/web/**

# Node modules and caches
node_modules/
**/node_modules/

# Git and CI metadata
.git/
.github/
.vercel/

# Next build output
.next/

# Monorepo folders we don't want to upload
apps/api/
worker/
packages/

# Misc build artifacts
scripts/
docs/
tests/
dist/
coverage/
.cache/

# Keep everything else (including apps/web/** and apps/web/prisma/**)
# Very restrictive .vercelignore for monorepo deployments

# Default: ignore everything
**

# Whitelist the web app and minimal files needed for building/deploying
!apps/
!apps/web/
!apps/web/**
!apps/web/package.json
!apps/web/next.config.mjs
!apps/web/tsconfig.json
!apps/web/public/**
!apps/web/prisma/**
!apps/web/.npmrc
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Exclude large folders and artifacts explicitly (safety)
node_modules/
**/node_modules/
.git/
.github/
.vercel/
.next/
apps/api/
worker/
packages/
prisma/
scripts/
docs/
tests/
dist/
coverage/
.cache/

# If you need other files to be included, explicitly whitelist them above.
# Very restrictive .vercelignore for monorepo deployments

# Default: ignore everything
