{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": [
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@sentry/nextjs",
      "next-auth"
    ],
    "paths": {
      "@classroom/api": [
        "../api/src/index.ts"
      ],
      "@classroom/env": [
        "../../packages/config/src/env.ts"
      ],
      "@web/config/env": [
        "./config/env.ts"
      ]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
