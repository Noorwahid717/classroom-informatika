{
  "builds": [
    { "src": "apps/web/package.json", "use": "@vercel/next" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/apps/web/$1" }
  ],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter web build && rm -rf .next && cp -R apps/web/.next .next",
  "github": { "silent": true }
}

